      "docs": "watch/settings",
      "docsLinkable": true
    },
    "team": {
      "label": "Open the Team page",
      "opens": "Team page.",
      "target": {
        "path": "/account/team"
      },
      "params": [],
      "role": "general_manager",
      "belowRole": "page",
      "docs": "team/inviting-and-removing-people",
      "docsLinkable": true
