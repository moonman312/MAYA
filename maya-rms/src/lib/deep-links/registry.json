    },
    "settings": {
      "label": "Open Settings",
      "opens": "The dashboard with Settings open. Nothing is changed.",
      "target": {
        "path": "/"
      },
      "params": [],
      "docs": "watch/settings",
      "docsLinkable": true
    },
    "settings.pms": {
      "label": "Open the property system setting",
