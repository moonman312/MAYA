    "billing.card": {
      "label": "Open Billing at the card button",
      "opens": "Billing page with Update card, receipts & cancellation highlighted. Stripe is never opened.",
      "target": {
        "path": "/account/billing",
        "set": {
          "focus": "card"
        }
      },
      "params": [],
      "role": "general_manager",
