-- Example: schedule Edge Function `think-scheduled-sync` every 5 minutes.
-- Parallel to cron/mews-sync-every-5-min.sql.example. Prereqs: extensions
-- `pg_cron`, `pg_net`; Vault secrets. Run in Supabase Dashboard → SQL Editor.
--
-- 0) Ensure pg_net exists (creates schema `net`):
--    create extension if not exists pg_net;
--    create extension if not exists pg_cron;
--
-- 1) Store secrets (reuse `project_url` if you already created it for Mews):
--    select vault.create_secret('https://<project-ref>.supabase.co', 'project_url');
--    select vault.create_secret('<long-random-string>', 'think_cron_secret');
--    -- To read existing secret names: select name from vault.secrets;
--
-- 2) Edge Function secrets (Dashboard → Edge Functions → Secrets):
--    SUPABASE_SERVICE_ROLE_KEY  (auto in hosted projects; confirm)
--    THINK_CRON_SECRET          (same value as vault `think_cron_secret`)
--    THINK_CLIENT_ID / THINK_CLIENT_SECRET   (for token refresh)
--    MAYA_PUSH_RATES_THINK      (true to send prices to Live hotels on
--                               ThinkReservations. Off until set: MAYA_PUSH_RATES
--                               no longer turns it on, and ThinkReservations has
--                               not confirmed how its rates should be written.
--                               Unset, or any value other than true, sends
--                               nothing and says so in this function's log on
--                               every run. Pilot health shows "Sending:
--                               ThinkReservations on/off". Before setting it,
--                               this should return no rows unless they are meant
--                               to be sent to:
--                                 select h.id, h.name from hotels h
--                                   join hotel_settings s on s.hotel_id = h.id
--                                   join pms_connections c on c.hotel_id = h.id
--                                  where c.pms_type = 'think' and s.simulation_mode = false;)
--    MAYA_ALERT_WEBHOOK         (https:// webhook the alerts go to; without it
--                               nothing leaves MAYA when pricing or sending stops.
--                               Each run says in its log and on Pilot health
--                               whether it is set; the Command Center's
--                               "Send a test alert" sends through this function)
--    MAYA_ALERT_MIN_SEVERITY    (warn to send warnings too; unset sends critical only)
--    Optional: THINK_API_BASE_URL, THINK_TOKEN_URL, THINK_PAGE_SIZE,
--              MAYA_SYNC_DAYS_BACK, MAYA_SYNC_DAYS_FORWARD,
--              MAYA_RUN_EVALUATE (default true)
--
-- 3) Schedule:
--    select cron.schedule(
--      'think-sync-every-5-min',
--      '*/5 * * * *',
--      $$
--      select net.http_post(
--        url := (select decrypted_secret from vault.decrypted_secrets where name = 'project_url')
--               || '/functions/v1/think-scheduled-sync',
--        headers := jsonb_build_object(
--          'Content-Type', 'application/json',
--          'x-think-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name = 'think_cron_secret')
--        ),
--        body := jsonb_build_object('scheduled_at', now())
--      ) as request_id;
--      $$
--    );
--
-- Inspect:   select jobid, jobname, schedule, active from cron.job;
-- Runs log:  select * from cron.job_run_details order by start_time desc limit 20;
-- Unschedule: select cron.unschedule('think-sync-every-5-min');
--
-- TIP: To stagger load, offset Think from Mews and Cloudbeds, e.g. schedule at
-- '4-59/5 * * * *' (runs at :04, :09, :14, ...) instead of '*/5 * * * *'.
