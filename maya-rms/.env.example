# Supabase connection — leave blank to run in demo/in-memory mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Command Center (/admin) — required for platform-admin routes.
# SERVER-ONLY. Never expose to the browser. Never prefix with NEXT_PUBLIC_.
# On Vercel set this in Environment Variables (Production + Preview only).
# Grab from Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used when sending Supabase Auth invites. Must match the deployed
# host of this Next.js app so the customer's magic link lands on our
# /auth/accept-invite page. Also allowlist it in Supabase Dashboard →
# Authentication → URL Configuration → Additional Redirect URLs.
# Dev example:  http://localhost:3000
# Prod example: https://maya.your-domain.com
MAYA_INVITE_REDIRECT_BASE=http://localhost:3000

# Optional, dev only: default hotel UUID when the user has no hotel_memberships row. Ignored in production.
# MAYA_DEFAULT_HOTEL_ID=

# ============================================================================
# OAuth-based PMS integrations (Cloudbeds, Think Reservations)
# ============================================================================
# Both use OAuth2 authorization code flow. Callback URLs land on
# /api/pms/{cloudbeds|think}/callback, derived from MAYA_INVITE_REDIRECT_BASE.
# Leave blank while waiting on vendor sandbox credentials — the UI will show
# each PMS as "not configured" without crashing.

# Cloudbeds sandbox app credentials
# From Cloudbeds Dashboard → App Details page. See MAYA/docs/pms-integrations-status.md.
# CLOUDBEDS_CLIENT_ID=
# CLOUDBEDS_CLIENT_SECRET=
# Optional override for the Cloudbeds authorize base URL (defaults to hotels.cloudbeds.com).
# CLOUDBEDS_AUTHORIZE_BASE_URL=https://hotels.cloudbeds.com
# Optional full-URL overrides if Cloudbeds moves endpoints again. Defaults:
#   authorize: {BASE}/api/v1.3/oauth
#   token:     {BASE}/api/v1.3/access_token   (no /oauth segment!)
# CLOUDBEDS_AUTHORIZE_URL=
# CLOUDBEDS_TOKEN_URL=
# Lets the Next app ask a hotel's *-scheduled-sync edge function to push a
# manually typed price right away instead of waiting for cron. Each must equal
# the secret its edge function checks (x-cloudbeds-cron-secret and so on); the
# app picks the one matching the hotel's connected PMS. Leave them unset and
# manual prices are still saved and applied — they just go out on the next
# 5-minute cycle.
# CLOUDBEDS_CRON_SECRET=
# THINK_CRON_SECRET=
# MEWS_CRON_SECRET=

# How many nights ahead MAYA prices and pushes rates (default 60). The
# scheduled syncs read it from the Supabase function secrets; this app reads it
# for manual prices and re-pricing. Set the same value in both places, or in
# neither. If they differ, a manual price can be told it is past the window
# (and the re-price after a room type change stops short) while the scheduled
# sync prices and pushes those nights anyway.
# MAYA_PRICING_HORIZON_DAYS=60

# Think Reservations sandbox app credentials
# From Think Reservations onboarding email (regenerate the Onetimesecret link if expired).
# THINK_CLIENT_ID=
# THINK_CLIENT_SECRET=
# Auth0 tenant details for Think are stable and match their onboarding email; override only if changed.
# THINK_AUTHORIZE_URL=https://auth.thinkreservations.com/authorize
# THINK_TOKEN_URL=https://auth.thinkreservations.com/oauth/token
# THINK_API_AUDIENCE=https://api.thinkreservations.com/

# HMAC key used to sign the OAuth `state` parameter (CSRF protection).
# 32+ random bytes, base64 or hex. Rotate at will — outstanding OAuth flows only
# live for a few minutes so rotation causes at most a benign "state mismatch" error.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PMS_OAUTH_STATE_SECRET=

# Optional: Mews demo/public tokens for server-side PMS test/sync when no pms_connections row exists
# (same values as shared/legacy-python/config.py MEWS_DEMO_*)
# MEWS_CLIENT_TOKEN=
# MEWS_ACCESS_TOKEN=
# MEWS_ENTERPRISE_ID=
# MEWS_BASE_URL=https://api.mews-demo.com/api/connector/v1
# MEWS_ENV=demo
# Chunk size for each reservations/getAll call (Mews max span is 100:00:00; default 96 h)
# MEWS_RESERVATIONS_WINDOW_HOURS=96
# Legacy: days are converted to hours and capped at 100
# MEWS_RESERVATIONS_WINDOW_DAYS=

# ============================================================================
# Billing
# ============================================================================
# Sales tax. Leave off until Stripe Tax has an ACTIVE registration in the
# jurisdictions you sell into — with none, Stripe collects nothing and shows no
# error, so this flag is the deliberate statement that the registrations exist.
# MAYA_COLLECT_TAX=true
# Terms of service. Checkout asks buyers to accept only once this is set; the
# page it points at must be publicly reachable.
# MAYA_TERMS_URL=https://maya.your-domain.com/terms
# Free days a Cloudbeds Marketplace signup gets before its first charge. A
# Flow A arrival has no signup code — the Marketplace listing is the gate — so
# this is the only trial it can receive. 0 or unset means none. A code that
# grants its own trial replaces this; the two never stack.
MAYA_MARKETPLACE_TRIAL_DAYS=7

# ── Docs (/docs, /support) ─────────────────────────────────────
# Nothing is needed: the docs build from content/docs with no variables, and
# questions readers send go to the docs_questions table on the service role.
# Optional kill switch: set to 1 to hide the docs helper (read at build time).
# DOCS_ASK_DISABLED=

# ── Sending prices ─────────────────────────────────────────────
# Not read by this app. It is a Supabase function secret, listed here so it
# is not forgotten: the Cloudbeds and Think scheduled syncs send prices to
# Live hotels only when it is true. Unset, or set to anything else ("yes",
# "1"), nothing is sent to any hotel, and the function's log says so on every
# run. Set it to false to say that is meant.
# MAYA_PUSH_RATES=true

# ── Alerts ─────────────────────────────────────────────────────
# The alert channel: an https:// incoming webhook (our Slack). Every real
# alert is raised inside the edge functions, which read it from the Supabase
# function secrets; this app does not read it. The Command Center's "Send a
# test alert" asks a scheduled sync function to send the test over its cron
# endpoint, with the cron secret above (CLOUDBEDS_CRON_SECRET, or Think's or
# Mews'), so the test passes only when the FUNCTION has the address. Pilot
# health shows "Alerts: ready" or "Alerts: missing" from what the functions
# report. MAYA_ALERT_MIN_SEVERITY (warn, or unset for critical only) is a
# function secret too.
# The database watchdog (pricing_watchdog, run by pg_cron every 10 minutes;
# supabase/cron/pricing-watchdog-every-10-min.sql.example) posts to the same
# address, read from the Vault secret maya_alert_webhook: store it there as
# well, since SQL cannot read the function secrets.
# MAYA_ALERT_WEBHOOK=  (not read by this app; set it in the function secrets)
